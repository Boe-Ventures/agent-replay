{
  "name": "@boe-ventures/agent-replay",
  "version": "0.3.0",
  "description": "A local, model-agnostic flight recorder for web development: capture once, debug with any agent, replay for humans, and export as video",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-replay": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "default": "./dist/next/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js",
      "default": "./dist/playwright/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "default": "./dist/mcp/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "build": "bun run build:viewer && tsc",
    "build:viewer": "bun run --cwd viewer build",
    "build:fixtures": "bun run --cwd playground build && bun run --cwd playground-vite build",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "bun test tests/unit",
    "test:all": "bun run test:unit && bun run test",
    "prepublishOnly": "bun run typecheck && bun run build && bun run test:unit",
    "pack:check": "bun pm pack --dry-run"
  },
  "keywords": [
    "session-recording",
    "rrweb",
    "ai-agent",
    "developer-tools",
    "debugging",
    "console-log",
    "network-capture",
    "react",
    "nextjs",
    "local-development",
    "devtools",
    "flight-recorder",
    "local-models",
    "playwright",
    "video-export"
  ],
  "homepage": "https://boe-ventures.github.io/agent-replay",
  "repository": {
    "type": "git",
    "url": "https://github.com/Boe-Ventures/agent-replay.git"
  },
  "bugs": {
    "url": "https://github.com/Boe-Ventures/agent-replay/issues"
  },
  "author": "Boe Ventures <hello@boe.ventures> (https://github.com/Boe-Ventures)",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@rrweb/rrweb-plugin-console-record": "2.1.0",
    "@rrweb/types": "2.1.0",
    "@rrweb/record": "2.1.0",
    "@rrweb/replay": "2.1.0",
    "fflate": "^0.8.2",
    "playwright": "1.61.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "@playwright/test": ">=1.61.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "workspaces": [
    "extension",
    "viewer",
    "site",
    "playground",
    "playground-vite"
  ],
  "packageManager": "bun@1.3.6"
}
